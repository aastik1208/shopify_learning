<%= content_tag :div, nil, id: 'shopify-app-page-title', data: { title: 'Shop Settings' } %>

<div class="col-md-9 col-xs-12 col-md-offset-1">
  <div class="well">

    <%= form_with model: current_shop, url: shop_setting_path(current_shop), class: 'form-horizontal' do |f| %>
      <fieldset>
        <legend>Shop Settings</legend>
        <div class="form-group">
          <%= f.label :admin_emails, class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <%= f.text_field :admin_emails, class: 'form-control', placeholder: 'Add Comma seperated emails', id: :shop_admin_emails %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :usage_limit_update_amount, class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <%= f.number_field :usage_limit_update_amount, min: 1, class: 'form-control', placeholder: 'Value by which to update codes usage limit', id: :shop_usage_limit_update_amount %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :usage_limit_update_amount_for_exhausted_codes, class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <%= f.number_field :usage_limit_update_amount_for_exhausted, min: 1, class: 'form-control', placeholder: 'Value by which to update codes usage limit for expired codes', id: :shop_usage_limit_update_amount_for_exhausted %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :show_inventory_count, class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <%= f.check_box :show_inventory_count %> If checked, inventory count for each product will shown on code page
          </div>
        </div>

        <div class="form-group">
          <%= f.label :automate_usage_limit_update, class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <%= f.check_box :automate_usage_limit_update %> If checked, usage limit will updated on 1st of every month
          </div>
        </div>

        <p class="row"></p>
        <div class="form-group">
          <div class="col-md-6 col-md-offset-3">
            <%= f.submit I18n.t(:save, scope: :action), class: 'btn btn-primary col-md-4' %>
          </div>
        </div>

      </fieldset>
    <% end %>
  </div>
</div>
