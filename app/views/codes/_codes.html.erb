<div class="table-responsive" >
  <table class="table table-striped table-hover codes-data"  >
    <thead>
      <tr>
        <th>Code</th>
        <th nowrap>Shipping Data<br>
          (<span data-toggle="tooltip" title= 'Domestic'>D</span>
          <span data-toggle="tooltip" title= 'Domestic Free'> DF</span>
          <span data-toggle="tooltip" title= 'International'> I</span>
          <span data-toggle="tooltip" title= 'International Free'> IF</span>)
        </th>
        <th nowrap>Product limit</th>
        <th nowrap>Expiry Date</th>
        <th nowrap>Usage Limit</th>
        <th>Times Used</th>
        <th>Last Used</th>
        <th>Orders</th>
        <th></th>
      </tr>
    </thead>

    <tbody >
      <% codes.each do |code| %>
          <tr>
            <td nowrap>
              <%= code.name %>
            </td>
            <td >
              <%= code.setting.allow_domestic_shipping ? 'Y' : '-'  %>
              <%= code.setting.has_free_domestic_shipping ? 'Y' : '-'  %>
              <%= code.setting.allow_international_shipping ? 'Y' : '-'  %>
              <%= code.setting.has_free_international_shipping ? 'Y' : '-'  %>
            </td>
            <td nowrap>
              <%= code.products_in_order_limit %>
            </td>
            <td nowrap>
                &nbsp;&nbsp;&nbsp;<%= code.expiry_date&.to_date %>
            </td>
            <td nowrap>
              <%= code.usage_limit %>
            </td>
            <td>
              <%= code.times_used %>
            </td>
            <td nowrap>
              <%= code.last_used_at ? code.last_used_at.strftime(' %l:%M %P %d %b %Y') : '-' %>
            </td>
            <td nowrap>
              <% if code.shopify_orders.blank? %>
                -
              <% else %>
                <% code.shopify_orders.each_with_index do |order, index| %>
                  <% if index > 0 %>, <% end %>
                  <a href="https://<%=current_shop.shopify_domain%>/admin/orders/<%=order.shopify_id%>" target="_blank"><%= order.shopify_name %></a>
                  <%if (index % 4 == 0 && index!=0)%><br><%end%>
                <% end %>
              <% end %>
            </td>
            <td nowrap>
            <%= link_to I18n.t(:edit, scope: :action), edit_promo_code_path(code.id), class: 'btn btn-primary' %>
            <% unless code.last_used_at? %>
              <%= link_to I18n.t(:delete, scope: :action), promo_code_path(code.id), method: :delete, remote: :true, data: {confirm: "Are you sure?", disable_with: "Deleted"}, class: 'btn btn-danger' %>
            <% end %>
            </td>
          </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
$(document).ready(function(){
  $('[data-toggle="tooltip"]').tooltip();
});
</script>
