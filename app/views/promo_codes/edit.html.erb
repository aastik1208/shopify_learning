<%= content_tag :div, nil, id: 'shopify-app-page-title', data: { title: 'Promo Code Edit' } %>

<div class="col-md-9 col-xs-12 col-md-offset-1">
  <div class="well">

    <%= form_with model: @code, url: promo_code_path(@code.id), class: 'form-horizontal' do |f| %>
      <fieldset>
        <legend>Edit code: <%= @code.name %></legend>

        <div class="form-group">
          <%= f.label :usage_limit, class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <%= f.number_field :usage_limit, { value: @code.usage_limit, min: 1, class: 'form-control', id: :promo_code_usage_limit } %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label 'Number of products allowed in each order', class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <%= f.number_field :products_in_order_limit, { value: @code.products_in_order_limit, min: 1, class: 'form-control', id: :promo_code_products_in_order_limit } %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :expiry_date, class: 'control-label col-xs-5 col-md-3' %>
          <div class="col-xs-7 col-md-7">
            <% if !@code.expiry_date || @code.expiry_date >= Date.current %>
              <%= f.text_field :expiry_date, autocomplete: "off", value: @code.expiry_date&.to_date, class: 'form-control',
                data: { provide: 'datepicker', 'date-format' => 'yyyy-mm-dd', 'date-start-date': Date.today}, placeholder: 'YYYY-MM-DD' %>
            <% else %>
              <%= @code.expiry_date&.to_date %>
            <% end %>
          </div>
        </div>

        <div class="form-group">
          <label class='control-label col-xs-5 col-md-3'>Allows domestic shipping </label>
          <div class="col-xs-7 col-md-7">
            <%= @code.setting.allow_domestic_shipping ? 'Yes' : 'No' %>
          </div>
        </div>

        <div class="form-group">
            <label class='control-label col-xs-5 col-md-3'>Grants free domestic shipping</label>
          <div class="col-xs-7 col-md-7">
            <%= @code.setting.has_free_domestic_shipping ? 'Yes' : 'No'  %>
          </div>
        </div>

        <div class="form-group">
            <label class='control-label col-xs-5 col-md-3'>Allows international shipping</label>
          <div class="col-xs-7 col-md-7">
            <%= @code.setting.allow_international_shipping ? 'Yes' : 'No'  %>
          </div>
        </div>

        <div class="form-group">
            <label class='control-label col-xs-5 col-md-3'>Grants free international shipping</label>
          <div class="col-xs-7 col-md-7">
            <%= @code.setting.has_free_international_shipping ? 'Yes' : 'No'  %>
          </div>
        </div>

        <div class="form-group">
          <div class="col-md-6 col-md-offset-3">
            <%= f.submit I18n.t(:save, scope: :action), class: 'btn btn-primary' %>
            <%= button_tag I18n.t(:reset, scope: :action), type: :reset, class: 'btn btn-default' %>
            <%= link_to I18n.t(:cancel, scope: :action), promo_codes_path, class: 'btn btn-default' %>
          </div>
        </div>

      </fieldset>
    <% end %>
  </div>
</div>
