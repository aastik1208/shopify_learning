<%= content_tag :div, nil, id: 'shopify-app-page-title', data: { title: 'Promo Code Lookup' } %>

<div class="col-md-7 col-xs-12 col-md-offset-2">
  <div class="well">
    <%= form_with url: lookup_promo_codes_path, method: :post, class: 'form-horizontal' do |f| %>
      <fieldset>

        <div class="form-group">
          <%= f.label 'Enter Code Name', class: 'required-field control-label col-xs-4 col-md-3' %>
          <div class="col-xs-8 col-md-9">
            <%= f.text_field :code_name, class: 'form-control', required: true, placeholder: 'Enter Code like: AAA-DEMO or ABC-DEMO' %>
          </div>
        </div>

        <div class="form-group">
          <div class='col-xs-4 col-md-3'></div>
          <div class="col-xs-8 col-md-9">
            <%= f.submit 'Search and edit', class: 'btn btn-primary' %>
            <%= link_to I18n.t(:cancel, scope: :action), home_path, class: 'btn btn-default' %>
          </div>
        </div>

      </fieldset>
    <% end %>
  </div>
</div>
