<div>
  <ul class="nav nav-tabs">
    <li class="active"><a href="#products" data-toggle="tab" aria-expanded="true">Products</a></li>
  </ul>

  <div id="myTabContent" class="tab-content">
    <div class="tab-pane fade active in" id="products">
      <% if current_shop.products.blank? %>
        <h4>Products are being fetched. Please reload the page in some seconds.</h4>
      <% elsif @prefixes_with_products.blank? %>
        <h4>No products are available for promo codes yet.</h4>
      <% else %>
        <div class="table-responsive">
          <table class="table table-striped table-hover ">
            <thead>
              <tr>
                <th nowrap>Prefix Code</th>
                <th nowrap>Product Names</th>
              </tr>
            </thead>

            <tbody>
              <% @prefixes_with_products.each do |prefix| %>
                <tr>
                  <td nowrap>
                    <strong><%= prefix.name %>-########</strong>
                  </td>
                  <td nowrap>
                    <% if prefix.products.present? %>
                      <% prefix.products.order(:shopify_title).each_with_index do |product, index| %>
                        <% if index > 0 %>
                          ,
                        <% end %>
                        <a href="https://<%=current_shop.shopify_domain%>/admin/products/<%=product.shopify_id%>" target="_blank" ><%= product.shopify_title %></a>
                      <% end %>
                    <% else %>
                      -
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
