        }
      }
    }

  });
</script>

<script>
  $(document).ready(function(){

    function updateFormSubmitButton() {
      var $formSubmitButton = $("form[data-form-for='order_placement']").find("[type='submit']");
      var productsAllowed = $formSubmitButton.data('product-limit');
      var optionsInvalidFlag = false;

      var $enabledInput = $("input#order_variant_id:enabled");

      if ($enabledInput.length < 1) {
        optionsInvalidFlag = true;
      }

      $enabledInput.each(function(index, element){
        // console.log('Index: ' + index, '; Value found: '+ element.value);
        if(element.value == '') {
          // console.log('invalid');
          optionsInvalidFlag = true;
          return false;
        }
      });

      if ($enabledInput.length > productsAllowed) {
        // console.log('disabling');
        optionsInvalidFlag = true;
      }

      if (optionsInvalidFlag == true) {
        // console.log('enabling');
        $formSubmitButton.prop('disabled', true);
        $('[data-toggle="tooltip"]').tooltip( "enable" );
      }
      else {
        $formSubmitButton.prop('disabled', false);
        $('[data-toggle="tooltip"]').tooltip( "disable" );
      }
    }

    function showProductLimitReminder() {
      var productsAllowed = $("form[data-form-for='order_placement']").find("[type='submit']").data('product-limit');
      if ( $(".collection-container .figure.active").length > productsAllowed ) {
        window.alert('You have selected too many items. You will need to de-select items until only ' + productsAllowed + ' items are selected before you can submit.')
      }
    }

    function checkAvailability(figure_event, select_event) {
      var productId = (figure_event) ? $(figure_event).closest('.figure').data('product-id') : $(select_event).closest('.form--product-options').data('product-id');
      var $variantDivs = $(".form--product-options[data-product-id='" + productId + "']");
      var $formSubmitButton = $("form[data-form-for='order_placement']").find("[type='submit']");

      showProductLimitReminder();

      if ($variantDivs.find('select').length > 0) {
        var $variantNonDefaultDivs = $variantDivs.find('select');
        var productVariantsObject = $(".collection-container .figure[data-product-id='" + productId + "']").data('variant-ids');

        if (productVariantsObject) {
          var $unifiedVariantElement = $("input#order_variant_id[data-product-id='" + productId + "']")
          var variantTitlesArray = [];
          var variantTitle = '';
          var defaultOptionSelectFlag = 0;

          $variantNonDefaultDivs.each(function(index) {
            var valText = this.selectedOptions[0].value;
            variantTitlesArray.push(valText);
            if (valText == '') {
              defaultOptionSelectFlag = 1;
            }
          });
          variantTitle = variantTitlesArray.join(' / ');

          if (productVariantsObject[variantTitle] && productVariantsObject[variantTitle].available == 'true') {

            $unifiedVariantElement[0].value = productVariantsObject[variantTitle].variant_id;
            $unifiedVariantElement.prop('disabled', false);

            //check if image has active class present then unhide, if not(means product unselected) then don't
            if (figure_event && $(figure_event).closest('.figure').hasClass('active')) {
              $variantDivs.removeClass('hide');
            }
            $variantDivs.find('#product_variant_available').html('In Stock');
            // console.clear();
            // console.log('variant found');
          }
          else if (productVariantsObject[variantTitle] && productVariantsObject[variantTitle].available == 'false') {
            $variantDivs.find('#product_variant_available').html('Out of Stock');
            $unifiedVariantElement[0].value = '';
            // console.clear();
            // console.log('variant found, but not available');
          }
          else {
            $variantDivs.find('#product_variant_available').html('Please select valid option.');
            $unifiedVariantElement[0].value = '';
            // console.clear();
            // console.log('variant NOT found');
          }
          //enable/disable the form submit
          updateFormSubmitButton();
        }
      }
      else if ($variantDivs.find('input').length > 0) {
        // console.clear();
        // console.log('variant available: ' + $variantDivs.find('input').data('product-available'));
        updateFormSubmitButton();
      }
    }

    function setVariantImage(colorOption) {
      var selectedColor = colorOption.selectedOptions[0].value;
      var productId = $(colorOption).closest('.form--product-options').data('product-id');
      var imageActiveObject = $(".collection-container .figure[data-product-id='" + productId + "']");
      var productVariantsObject = imageActiveObject.data('variant-image-urls');

      if (productVariantsObject[selectedColor]) {
        imageActiveObject.children('img').attr('src', productVariantsObject[selectedColor].variant_image_url);
        $(`#id-${productId}`).find('img').attr('src', productVariantsObject[selectedColor].variant_image_url);
      }
    }

    $(document).on("change", ".form--product-options select#variant_id_color", (event) => setVariantImage(event.target) );

    $(document).on("change", ".form--product-options select", (event) => checkAvailability(undefined, event.target) );
    $(".collection-container").on('click', ".figure", (event) => checkAvailability(event.target, undefined) );

  });
</script>

<script type="text/javascript">
  $(document).ready(function(){
    var get_states_link = "{{ shop.secure_url | append: '/apps/advance_promo_codes/shop_store_front/states' }}";

    $('#country').on('change', function(event){
      var selected_country_id = parseInt(this.value),
          $state_text_field = $('#state').children("input#order_state_name"),
          $state_select_field = $('#state').children("select#order_state_id");

      $state_text_field.prop("disabled", true);
      $state_select_field.prop("disabled", true);

      $.getJSON(get_states_link, {'selected_country_id' : selected_country_id })

      .done(function(data){
        var $state_text_field = $('#state').children("input#order_state_name"),
            $state_select_field = $('#state').children("select#order_state_id");

        if(Object.keys(data).length == 0){
          // display state_text_field and hide state_select_field
          $state_select_field.css("display", "none");
          $state_select_field.prop("disabled", true);
          $state_text_field.css("display", "block");
          $state_text_field.prop("disabled", false);
        }
        else{
          // display state_select_field and hide state_text_field
          $state_text_field.css("display", "none");
          $state_text_field.prop("disabled", true);
          $state_select_field.css("display", "block");
          $state_select_field.prop("disabled", false);

          // removing old options
          $state_select_field.children().remove()

          //adding new options
          var new_options = '<option value=""></option>'

          $.each(data, function(key, value){
            new_options += "\n<option value=" + key + ">" + value + "</option>";
          });

          $state_select_field.append(new_options);
        }
      })
      .fail(function(xhr, status, error){
        // console.log("xhr: " + xhr + ", status: " + status + ", error: " + error);
      });
    });
  });
</script>

<script>
  function FormSubmitter(options){
    this.$formElement = options.$formElement;
    this.requestType = this.$formElement[0].method.toUpperCase();
    this.requestUrl = this.$formElement[0].action;
    this.$submitButton = this.$formElement.find("[type='submit']");
  }

  FormSubmitter.prototype.init = function(){
    this.$formElement.submit(this.sendAjaxRequest());
  };

  FormSubmitter.prototype.mergeVariantId = function(){
    var ids = [];
    $('input.variant_id:enabled').each(function(index, element){
      ids.push(element.value)
    });
    $("#order_variant_ids").val(ids.join());
  };

  FormSubmitter.prototype.sendAjaxRequest = function(){
    var _this = this;
    return function(event){
      event.preventDefault();

      _this.mergeVariantId();
      _this.$submitButton.prop('disabled', true);
      _this.$submitButton.attr('value', _this.$submitButton.data('disable-with'));

      $.ajax({
        url: _this.requestUrl,
        data: _this.$formElement.serialize(),
        type: _this.requestType
      })
      .done(function(response, status, xhr) {
        var expirationToken = xhr.getResponseHeader('expiration-token');
        if(response.redirect_link !== undefined){
          window.location.replace(response.redirect_link + "?etoken=" + expirationToken);
        }
        $("form[data-form-for='order_placement']").find("[type='submit']").prop('disabled', false).attr('value', 'Submit');
      })
      .fail(function( xhr, status, errorThrown ) {
        // console.log( "Error: " + errorThrown );
        // console.log( "Status: " + status );
        // console.dir( xhr );

        $('.formError, .alert-danger').removeClass('hide').addClass('hide').empty();

        //redirecting to app's storefront in case metafield is not set
        if(xhr.status == 301 && xhr.responseJSON.redirect_link != undefined){
          window.location.replace(xhr.responseJSON.redirect_link);
        }
        //rendering error
        else if(xhr.status === 422 && xhr.responseJSON.error === 'Invalid Request'){
          var error_messages = xhr.responseJSON.error_messages;
          $.each(error_messages, function(key, value){

            if(key === 'base'){
              var $errorElements = []
              value.forEach(function(e){
                $errorElements.push($("<p></p>").text(e).addClass('mb-0'));
              });
              $("[data-order-error-for=" + key + "]").append($errorElements).removeClass('hide');
            }else{
              $("[data-order-error-for=" + key + "]").html(value.join(' ,')).removeClass('hide');
            }

          });
        }
        $("form[data-form-for='order_placement']").find("[type='submit']").prop('disabled', false).attr('value', 'SUBMIT');
      });
    }
  };

  $(function(){
    var orderPlacementFromSubmitterArguments = { $formElement : $("form[data-form-for='order_placement']") },
        orderPlacementFromSubmitter = new FormSubmitter(orderPlacementFromSubmitterArguments);

    orderPlacementFromSubmitter.init();
  });
</script>

<script>
  $(document).ready(function(){
    $("input, textarea").not(".do-not-filter").keyup(function(){
      var strng = $(this).val();
      var cleanedStr = allowCharsOnly(strng);
      $(this).val(cleanedStr);
    });

    function allowCharsOnly (string) {
      var regex_allow = /[^a-zA-Z0-9!@#\$\^\&*\)\(\/\',:+=._-\s]/g;
      return string.replace(regex_allow, '');
    }
  });

  $(function () {
    $('[data-toggle="tooltip"]').tooltip();
  })
</script>

