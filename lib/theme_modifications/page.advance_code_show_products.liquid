    padding: .2em;
    background-color: #ffeb84;
  }
</style>
<script src="https://code.jquery.com/jquery-3.2.1.min.js" integrity="sha256-hwg4gsxgFZhOsEEamdOYGBf13FyQuiTwlAQgxVSNgt4=" crossorigin="anonymous"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>

<link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">

<link href="{{ 'advance_code_styles.css' | asset_url }}" rel="stylesheet" type="text/css"  media="all"  />

<div class="container code-logo-container text-center" hidden>
  <br><br><img  src="{{ 'logo.png' | asset_img_url:'400x' }}" ><br><br>
</div>

<script type="text/javascript">
  $(document).ready(function(){
    var codeStoreLink = "{{ shop.secure_url | append: '/pages/advance-code-store' }}";
    function getUrlParams(search) {
      let hashes = search.slice(search.indexOf('?') + 1).split('&')
      let params = {}
      hashes.map(hash => {
          let [key, val] = hash.split('=')
          params[key] = decodeURIComponent(val)
      })
      return params
    }

    var params = getUrlParams(window.location.search);

    if(params.code != undefined){
      var $newForm = $('<form>', {
          'action': "{{ shop.secure_url | append: '/apps/advance_promo_codes/shop_store_front/fetch_products' }}",
          'method': 'get'
      }).append($('<input>', {
          'name': 'code[name]',
          'value': params.code,
          'type': 'hidden'
      }));

      $.ajax({
          url: $newForm[0].action,
          data: $newForm.serialize(),
          type: $newForm[0].method.toUpperCase()
        })
      .done(function(response) {
        var res=jQuery.parseHTML(response),
            data = JSON.parse(res[0].data),
            products = data.products,
            countries = data.countries,
            states = data.states,
            shipping = data.shipping,
            products_limit = data.products_limit,
            show_inventory_count = data.show_inventory_count,
            $productsContainer = $("[data-for='products_collection']"),
            $productTemplate = $("[data-template-for='product']").removeAttr('data-template-for').remove(),
            $imageZoomModalTemplate = $("[data-template-for='image-zoom']").removeAttr('data-template-for').remove(),
            $productsVariantsContainer = $("#products_variants"),
            $variantProductNameTemplate = $("[data-template-for='product_variant_name']").removeAttr('data-template-for').remove(),
            $productVariantAvailableTemplate = $("[data-template-for='product_variant_available']").removeAttr('data-template-for').remove(),
            $multipleVariantTemplate = $("[data-template-for='multiple_variant']").removeAttr('data-template-for').remove(),
            $singleVariantTemplate = $("[data-template-for='single_variant']").removeAttr('data-template-for').remove(),
            $unifiedMultipleVariantTemplate = $("[data-template-for='unified_multiple_variant']").removeAttr('data-template-for').remove(),
            $countrySelector = $('#country'),
            $stateSelector = $('#state #order_state_id'),
            $stateTextField = $('#state #order_state_name'),
            $imageElements = $('.collection-container');

        var productsElementsArray = [],
            variantsElementsArray = [],
            countryOptionsArray = [],
            stateOptionsArray = [];

        let variantsNamesObject= {};
        let variantsIdsObject= {};
        let variantsUrlsObject= {};

        //rendering shipping data
        var $shipping_type_span = $("#shipping-type"),
            $free_shipping_for_span = $("#free-shipping-for"),
            shipping_type = shipping.shipping_type,
            free_shipping_for = shipping.free_shipping_for;

        if(shipping_type == 'domestic'){
          $shipping_type_span.text('We can ship this swag anywhere in the continental US.');
        }else if(shipping_type == 'international'){
          $shipping_type_span.text('We can only ship this particular swag outside of the continental US. ');
        }else if(shipping_type == 'all'){
          $shipping_type_span.text('We can ship this swag anywhere in the world. ')
        }

        if(shipping_type == 'domestic'){
          if(free_shipping_for == 'domestic'){
            $free_shipping_for_span.text('No shipping charges will be applied.')
          }else{
            $free_shipping_for_span.text('Shipping charges apply.')
          }
        }
        else if(shipping_type == 'international'){
          if(free_shipping_for == 'international'){
            $free_shipping_for_span.text('No shipping charges will be applied.')
          }else{
            $free_shipping_for_span.text('Shipping charges apply.')
          }
        }
        else if(shipping_type == 'all'){
          if(free_shipping_for == 'domestic'){
            $free_shipping_for_span.text('Swag headed overseas will be subject to shipping charges.')
          }else if(free_shipping_for == 'international'){
            $free_shipping_for_span.text('Swag headed for continental US will be subject to shipping charges.')
          }else if(free_shipping_for == 'all'){
            $free_shipping_for_span.text('No shipping charges will be applied.')
          }
        }

        //rendering product limit
        var $product_limit_span = $("#product-limit");
        $product_limit_span.html(products_limit);
        $("form[data-form-for='order_placement']").find("[type='submit']").data('product-limit', products_limit);

        // rendering products
        if(products.length == 1){
          var $productElement = $productTemplate.clone().addClass('col-md-12').attr({'data-product-id':products[0].id, 'data-product-title': products[0].title});
          $productElement.children('img').attr('src', products[0].imageUrl.replace('small', 'grande'));
          $productElement.attr('data-target', `#id-${products[0].id}` );
          var $imageZoomModalElement = $imageZoomModalTemplate.clone().prop('id', `id-${products[0].id}`);
          $imageZoomModalElement.find('img').attr('src', products[0].imageUrl.replace('small', 'grande'));
          $imageZoomModalElement.find('.modal-title').html(products[0].title);

          if (show_inventory_count)
          {
            $productElement.children('span.inventory-count').html('OUT OF STOCK').addClass('inventory-out');
          }
          productsElementsArray.push($productElement);
          productsElementsArray.push($imageZoomModalElement);
          $productsContainer.addClass('single-product');
        }else{
          products.forEach(function(p, index){
            var $productElement = $productTemplate.clone().addClass('col-md-6').attr({'data-product-id':p.id, 'data-product-title': p.title});
            $productElement.children('img').attr('src', p.imageUrl.replace('small', 'grande'));
            $productElement.attr('data-target', `#id-${p.id}` );
            var $imageZoomModalElement = $imageZoomModalTemplate.clone().prop('id', `id-${p.id}`);
            $imageZoomModalElement.find('img').attr('src', p.imageUrl.replace('small', 'grande'));
            $imageZoomModalElement.find('.modal-title').html(p.title);

            if (show_inventory_count)
            {
              $productElement.children('span.inventory-count').html('OUT OF STOCK').addClass('inventory-out');
            }

            productsElementsArray.push($productElement);
            productsElementsArray.push($imageZoomModalElement);
          });
        }
        $productsContainer.append(productsElementsArray);

        //setting code id
        $('#order_code_id').attr('value', data.code.id);

        //rendering countries
        // first country will be selected
        countries.forEach(function(c, index){
          var $countryOption = null;
          if(index == 0){
            $countryOption = $('<option>', { 'selected': 'selected', 'value': c.id }).html(c.name);
          }else{
            $countryOption = $('<option>', { 'value': c.id }).html(c.name);
          }
          countryOptionsArray.push($countryOption);
        });
        $countrySelector.append(countryOptionsArray);

        //rendering states
        if(states == null){
          $stateTextField.prop("disabled", false);
          $stateTextField.css("display", "block");
        }else{
          states.forEach(function(s, index){
            var $stateOption = $('<option>', { 'value': s.id }).html(s.name);
            stateOptionsArray.push($stateOption);
          });
          $stateSelector.append(stateOptionsArray);
          $stateSelector.prop("disabled", false);
          $stateSelector.css("display", "block");
        }

        //rendering variants
        products.forEach(function(p, index){

          var options = p.variantOptions.split('/');

          if(options.length == 1 && options[0] == 'Title' && p.variants.split('||').slice(1).length == 1){
            var $singleVariantElement = $singleVariantTemplate.clone();
            var vprop = {};

            p.variants.split('||')[1].split(',').forEach(function(prop){
              prop = prop.split('=');
              vprop[prop[0]] = prop[1];
            });

            var product_available = vprop['available'];
            var product_inventory_quantity = vprop['inventory_quantity'];
            var product_inventory_policy = vprop['inventory_policy'];

            $singleVariantElement.attr('data-product-id', p.id);
            $singleVariantElement.find('input').data('product-available', product_available );

            $singleVariantElement.children('input#order_variant_id').prop('disabled', true);

            if(product_inventory_quantity > 0 || product_inventory_policy == 'continue' ){
              $singleVariantElement.children('input#order_variant_id').attr('value', vprop['id']);
            }

            if(product_inventory_quantity > 0 && show_inventory_count) {
              $('.figure[data-product-id=' + p.id + ']').find('.inventory-count').html(product_inventory_quantity).addClass('inventory-in').removeClass('inventory-out');
            }
            else if(product_inventory_policy == 'continue' && show_inventory_count) {
              $('.figure[data-product-id=' + p.id + ']').find('.inventory-count').html('In Stock').addClass('inventory-in').removeClass('inventory-out');
            }

            variantsElementsArray.push($singleVariantElement);

            // push prodcut name here first
            var $productVariantAvailableElement = $productVariantAvailableTemplate.clone();

            var productAvailableText = '';
            if (product_inventory_quantity > 0 || product_inventory_policy == 'continue') {
              productAvailableText = "Product: " + p.title + " selected is <strong>In Stock</strong>";
            }
            else {
              productAvailableText = "Product: " + p.title + " selected is <strong>Out of Stock</strong>";
            }

            $productVariantAvailableElement.attr('data-product-id', p.id);
            $productVariantAvailableElement.html("<p style='font-size: 17px;'>" + productAvailableText + "</p><hr>");

            variantsElementsArray.push($productVariantAvailableElement);

          }else{
            variantsNamesObject= {};
            variantsIdsObject[p.id] = {};
            let variantsName = p.variantOptions.split('/');
            let colorIndex = variantsName.indexOf('Color');
            variantsUrlsObject[p.id] = {};
            var product_inventory_quantity = 0;
            var product_inventory_policy = false;

            p.variants.split('||').slice(1).forEach(function(variant, ind){
              var vprop = {};
              let colorName;
              variant.split(',').forEach(function(prop){
                prop = prop.split('=');
                vprop[prop[0]] = prop[1];
                if (prop[0] == 'title')
                {
                  titles = prop[1].split(' / ');
                  colorName = titles[colorIndex];
                  titles.forEach(function(title, index){
                    if (variantsNamesObject[variantsName[index]] == undefined )
                    {
                      variantsNamesObject[variantsName[index]] = []
                    }
                    variantsNamesObject[variantsName[index]].push(title)
                  })
                }

              });

              product_inventory_quantity = product_inventory_quantity + parseInt(vprop['inventory_quantity']);
              if( !product_inventory_policy && vprop['inventory_quantity'] == 'continue' ){
                product_inventory_policy = true;
              }

              variantsIdsObject[p.id][vprop['title']] = { variant_id: parseInt(vprop.id), available: vprop.available};
              variantsUrlsObject[p.id][colorName] = { variant_image_url: vprop.variant_image_url};
            });

            $imageElements.find(".figure[data-product-id='"+ p.id +"']").data('variant-image-urls', variantsUrlsObject[p.id]);
            $imageElements.find(".figure[data-product-id='"+ p.id +"']").data('variant-ids', variantsIdsObject[p.id]);

            // push product name here first
            var $variantProductNameElement = $variantProductNameTemplate.clone();
            $variantProductNameElement.find('#product_variant_name').html(p.title);
            $variantProductNameElement.attr('data-product-id', p.id);

            variantsElementsArray.push($variantProductNameElement);

            variantsName.forEach(function(title, _i){
              variantsNamesObject[title] = variantsNamesObject[title].filter((v,i,a) => a.indexOf(v) === i)
              var $multipleVariantElement = $multipleVariantTemplate.clone();
              $multipleVariantElement.find('label').html(title);

              variantsNamesObject[title].forEach(function(title_name, _index){
                var $optionElement = $('<option>', { 'key': title_name, 'value': title_name });
                $optionElement.html(title_name);

                $multipleVariantElement.attr('data-product-id', p.id);
                var var_name = "variant_id_" + title.toLowerCase();
                $multipleVariantElement.find('select').attr({'id': var_name, 'name': "order[" + var_name + "]" });
                $multipleVariantElement.find('select').append($optionElement);
              });

              $multipleVariantElement.find('select').prop('disabled', true);
              variantsElementsArray.push($multipleVariantElement);

            })

            // push product variant available here
            var $productVariantAvailableElement = $productVariantAvailableTemplate.clone();
            $productVariantAvailableElement.attr('data-product-id', p.id);
            variantsElementsArray.push($productVariantAvailableElement);

            var $unifiedMultipleVariantElement = $unifiedMultipleVariantTemplate.clone();
            $unifiedMultipleVariantElement.attr('data-product-id', p.id);
            $unifiedMultipleVariantElement.children('input#order_variant_id').attr({'value': '', 'data-product-id': p.id, 'disabled': 'true'});

            variantsElementsArray.push($unifiedMultipleVariantElement);

            if(product_inventory_quantity > 0 && show_inventory_count) {
              $('.figure[data-product-id=' + p.id + ']').find('.inventory-count').html(product_inventory_quantity).addClass('inventory-in').removeClass('inventory-out');
            }
            else if(product_inventory_policy && show_inventory_count) {
              $('.figure[data-product-id=' + p.id + ']').find('.inventory-count').html('In Stock').addClass('inventory-in').removeClass('inventory-out');
            }
          }
          $productsVariantsContainer.append(variantsElementsArray);
        });

      })
      .fail(function( xhr, status, errorThrown ) {
        // console.log( "Error: " + errorThrown );
        // console.log( "Status: " + status );
        // console.dir( xhr );
        //redirecting to app's storefront in case metafield is not set
        if(xhr.status == 301 && xhr.responseJSON.redirect_link != undefined){
          window.location.replace(xhr.responseJSON.redirect_link);
        }
        else if(xhr.status === 422 || xhr.status === 404){
          window.location.replace(codeStoreLink + "?error=" + xhr.responseJSON.error.replace(/\s/g, "_") );
        }
      });

    }else{
      window.location.replace(codeStoreLink);
    }
  })
</script>

<script>
  $(document).ready(function(){
    var productContainer = $(".product-collection-section");

    function adjustHeight(){
      var windowHeight = $(window).height();
      if(productContainer.offset().top < windowHeight ){
        productContainer.height(windowHeight - productContainer.offset().top);
      }
    }

    adjustHeight();

    $(".collection-container").on('click', ".figure", function(){

      adjustHeight();

      function arrayRemove(arr, value) {
        return arr.filter(function(ele){
          return ele != value;
        });
      }

      // hides check mark from previous selected product
      $(".product-collection-section .figure").removeClass('js-active');

      var product_id = $(this).data('product-id');
      var product_title = $(this).data('product-title');

      // shows check mark on clicked product
      if($(this).hasClass('active'))
      {
        $(this).removeClass('active js-active');

        // finds and hide variants for clicked product
        var $div = $(".form--product-options[data-product-id='"+ product_id +"']");
        $div.addClass('hide');

        // disable options for clicked product
        $div.find('select.variant_id').prop({'disabled': true, 'selectedIndex': 0});
        $div.find('input.variant_id').prop({'disabled': true, 'val': ''});

        // sets product_id for clicked product
        var array = $('input.product_id').val().split(',');
        var new_val = arrayRemove(array, product_id.toString()).join();
        $('input.product_id').val(new_val);

      } else {
        $(this).addClass('active js-active');

        // finds and unhide variants for clicked product
        var $div = $(".form--product-options[data-product-id='"+ product_id +"']");
        $div.removeClass('hide');

        // enables options for clicked product
        $div.find('.variant_id').prop('disabled', false);

        // sets product_id for clicked product
        var current_product_id = $('input.product_id').val();
        var new_val = current_product_id + "," + product_id
        $('input.product_id').val(new_val);
      }

    });


    $(window).resize(function(){
      adjustHeight();
    });
  });
</script>

<script>
  $(document).ready(function() {
    var newHireKit = [];

    function setCustomText(prefix) {
      if (newHireKit.includes(prefix)) {
        // $("#customize-headline").html("");
        // $('#customize-subheadline').html("");
        // $("#shipping").html("");
      }
    }

    var queryString = window.location.href.split('?')[1];

    if (queryString !== undefined && queryString.split('=')[0] === 'code') {
