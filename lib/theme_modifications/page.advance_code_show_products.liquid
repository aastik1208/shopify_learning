{% layout none %}
<style type="text/css">
  .modal.in {
  	background-color: transparent;
  }
  .modal-open .page-container {
  	transform: initial;
  }
  .formError {
    color: red;
  }
  .header_border{
   display: none;
  }
  .inventory-count {
    height: 50px;
    width: 50px;
    position: absolute;
    right: 5px;
    top: 5px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: normal;
    text-align: center;
    font-size: 11px;
    z-index: 1;
  }

  .inventory-out {
    background-color: red;
  }

  .inventory-in {
    background-color: #1b36bf;
  }
  .single-product {
    display: flex;
    justify-content: center;
  }
